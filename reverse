#include <stdio.h>
#include <string.h>

#define MAX 100

// Define the global stack and top tracker
char stack[MAX];
int top = -1;

// Function to push a character onto the stack
void push(char ch) {
    if (top >= MAX - 1) {
        printf("Stack Overflow\n");
        return;
    }
    stack[++top] = ch;
}

// Function to pop a character from the stack
char pop() {
    if (top < 0) {
        printf("Stack Underflow\n");
        return '\0';
    }
    return stack[top--];
}

// Function to reverse the input word using the stack
void reverseWord(char word[]) {
    int len = strlen(word);

    // Step 1: Push all characters of the word onto the stack
    for (int i = 0; i < len; i++) {
        push(word[i]);
    }

    // Step 2: Pop characters back into the array in reverse order
    for (int i = 0; i < len; i++) {
        word[i] = pop();
    }
}

int main() {
    char word[MAX] = "HelloWorld";

    printf("Original word: %s\n", word);

    // Call the reversal function
    reverseWord(word);

    printf("Reversed word: %s\n", word);

    return 0;
}
