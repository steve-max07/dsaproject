#include <stdio.h>
#include <string.h>

#define MAX 100

// Define a Stack structure
typedef struct {
    char items[MAX];
    int top;
} Stack;

// Function to push a character onto the stack
void push(Stack *s, char ch) {
    if (s->top >= MAX - 1) {
        printf("Stack Overflow\n");
        return;
    }
    s->items[++(s->top)] = ch;
}

// Function to pop a character from the stack
char pop(Stack *s) {
    if (s->top < 0) {
        printf("Stack Underflow\n");
        return '\0';
    }
    return s->items[(s->top)--];
}

// Function to reverse the input word using the stack pointer
void reverseWord(char word[]) {
    int len = strlen(word);
    Stack myStack;
    myStack.top = -1; // Initialize the stack locally

    // Step 1: Push all characters onto the stack
    for (int i = 0; i < len; i++) {
        push(&myStack, word[i]);
    }

    // Step 2: Pop characters back into the array
    for (int i = 0; i < len; i++) {
        word[i] = pop(&myStack);
    }
}

int main() {
    char word[MAX];

    printf("Enter a word to reverse: ");
    fgets(word, MAX, stdin);

    // Remove the trailing newline character
    word[strcspn(word, "\n")] = '\0';

    printf("Original word: %s\n", word);

    // Call the reversal function
    reverseWord(word);

    printf("Reversed word: %s\n", word);

    return 0;
}
